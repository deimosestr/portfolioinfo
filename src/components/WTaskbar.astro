---
// src/components/WTaskbar.astro
import WindowsIcon from "./icons/WindowsIcon.astro";
import SearchIcon from "./icons/SearchIcon.astro";
import ExplorerIcon from "./icons/ExplorerIcon.astro";
---

<div
  class="fixed bottom-0 left-0 w-full h-12 bg-[#202020]/85 backdrop-blur-2xl border-t border-white/10 flex items-center justify-between px-4 z-50 select-none"
>
  <div class="w-1/3 flex items-center justify-start">
    <button
      id="theme-toggle-taskbar"
      class="w-8 h-8 rounded hover:bg-white/10 text-white transition-colors flex items-center justify-center"
      title="Cambiar Tema"
    >
      <svg
        class="size-4 block dark:hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
        ></path>
      </svg>

      <svg
        class="size-4 hidden dark:block"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
        ></path>
      </svg>
    </button>
  </div>

  <div class="flex-1 flex justify-center items-center gap-1">
    <button
      class="w-10 h-10 rounded hover:bg-white/10 flex items-center justify-center transition-colors"
      title="Inicio"
    >
      <WindowsIcon />
    </button>

    <button
      class="w-10 h-10 rounded hover:bg-white/10 flex items-center justify-center transition-colors text-white"
      title="Buscar"
    >
      <SearchIcon />
    </button>

    <button
      class="relative w-10 h-10 rounded hover:bg-white/10 flex items-center justify-center transition-colors bg-white/5"
      title="Explorador"
    >
      <ExplorerIcon />
      <div class="absolute bottom-0 w-4 h-1 bg-gray-400 rounded-full"></div>
    </button>
  </div>

  <div class="w-1/3 flex justify-end items-center gap-2">
    <button
      class="px-2 h-8 rounded hover:bg-white/10 flex items-center justify-center text-white transition-colors"
    >
      <svg class="size-3" viewBox="0 0 16 16" fill="currentColor">
        <path d="M8 4L1 11h14L8 4z"></path>
      </svg>
    </button>

    <button
      class="px-2 h-10 rounded hover:bg-white/10 flex flex-col items-end justify-center text-white text-[11px] leading-tight transition-colors"
    >
      <span id="win-time">--:-- --</span>
      <span id="win-date">--/--/----</span>
    </button>
  </div>
</div>

<script>
  function updateClock() {
    const now = new Date();

    let hours = now.getHours();
    let minutes = now.getMinutes();
    const ampm = hours >= 12 ? "p.m." : "a.m.";

    hours = hours % 12;
    hours = hours ? hours : 12;
    const minutesStr = minutes < 10 ? "0" + minutes : minutes;

    const timeString = `${hours}:${minutesStr} ${ampm}`;

    const day = String(now.getDate()).padStart(2, "0");
    const month = String(now.getMonth() + 1).padStart(2, "0");
    const year = now.getFullYear();

    const dateString = `${day}/${month}/${year}`;

    const timeElement = document.getElementById("win-time");
    const dateElement = document.getElementById("win-date");

    if (timeElement) timeElement.textContent = timeString;
    if (dateElement) dateElement.textContent = dateString;
  }

  updateClock();
  setInterval(updateClock, 60000);

  const themeBtn = document.getElementById("theme-toggle-taskbar");

  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.contains("dark");

      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("color-theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("color-theme", "dark");
      }
    });
  }
</script>
