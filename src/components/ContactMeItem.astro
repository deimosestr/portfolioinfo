---
// src/components/ContactItem.astro
interface Props {
  platform: string;
  username: string;
  link: string;
  actionText: string;
}

const { platform, username, link, actionText } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col items-center justify-center p-6 sm:p-8 rounded-3xl hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-500 cursor-pointer"
>
  <div
    class="relative size-28 sm:size-32 rounded-full bg-gray-100 dark:bg-[#202020] border-2 border-transparent group-hover:border-gray-300 dark:group-hover:border-white/20 flex items-center justify-center mb-5 shadow-xl transition-all duration-300 group-hover:scale-105 group-hover:shadow-2xl"
  >
    <div class="absolute inset-0 rounded-full shadow-inner opacity-50"></div>

    <div
      class="z-10 flex items-center justify-center text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-white transition-colors duration-300"
    >
      <slot name="icon" />
    </div>
  </div>

  <h3
    class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white mb-1"
  >
    {platform}
  </h3>
  <p class="text-sm text-gray-500 dark:text-gray-400 font-medium tracking-wide">
    {username}
  </p>

  <div class="mt-4 h-10 w-full flex justify-center overflow-hidden">
    <div
      class="opacity-0 translate-y-full group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 ease-out flex items-center gap-2 px-6 py-2 bg-white dark:bg-white/10 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 rounded-full font-medium text-sm hover:bg-gray-100 dark:hover:bg-white/20 shadow-sm"
    >
      {actionText}
      <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </div>
  </div>
</a>
