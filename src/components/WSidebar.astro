---
// src/components/WSidebar.astro
---

<div id="sidebar-wrapper" class="relative h-full flex shrink-0 z-50">
  <button
    id="open-sidebar-btn"
    class="absolute top-2 left-0 z-50 p-1.5 bg-gray-100 dark:bg-[#202020] border border-gray-300 dark:border-white/10 border-l-0 rounded-r-lg shadow-md text-gray-500 hover:text-blue-500 dark:hover:text-blue-400 hover:bg-gray-200 dark:hover:bg-white/10 transition-all duration-300 flex items-center justify-center group opacity-100 pointer-events-auto translate-x-0 md:opacity-0 md:pointer-events-none md:-translate-x-full"
    aria-label="Abrir menú lateral"
  >
    <svg
      class="size-4 group-hover:scale-110 transition-transform"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 19l7-7-7-7m8 14l7-7-7-7"></path>
    </svg>
  </button>

  <aside
    id="windows-sidebar"
    class="absolute left-0 top-0 z-40 md:relative md:z-auto flex flex-col bg-gray-100 dark:bg-[#181818] border-gray-300 dark:border-white/10 h-full overflow-hidden select-none transition-all duration-300 ease-in-out shrink-0 w-0 min-w-0 border-r-0 opacity-0 md:w-64 md:border-r md:opacity-100 shadow-2xl md:shadow-none"
  >
    <div
      class="px-4 py-3 flex items-center justify-between border-b border-gray-300 dark:border-white/10 min-w-[256px]"
    >
      <span
        class="text-[11px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider"
        >Menú</span
      >
      <button
        id="close-sidebar-btn"
        class="p-1 rounded-md text-gray-500 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-white/10 transition-colors"
        aria-label="Ocultar menú"
      >
        <svg
          class="size-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
        </svg>
      </button>
    </div>

    <div class="overflow-y-auto h-full py-3 px-2 min-w-[256px]">
      <ul
        class="text-[13px] text-gray-700 dark:text-gray-300 space-y-1 font-sans"
      >
        <li>
          <a
            href="#"
            class="flex items-center gap-3 p-2 rounded hover:bg-gray-200 dark:hover:bg-white/10 cursor-pointer transition-colors"
          >
            <svg
              class="size-4 text-gray-500 dark:text-gray-400"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146z"
              ></path>
            </svg>
            <span>Inicio</span>
          </a>
        </li>
        <li
          class="flex items-center gap-3 p-2 rounded hover:bg-white/10 cursor-pointer transition-colors"
        >
          <svg
            class="size-4 text-gray-400"
            viewBox="0 0 16 16"
            fill="currentColor"
            ><path
              d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1H2.5A1.5 1.5 0 0 0 1 4v9a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 15 13V4a1.5 1.5 0 0 0-1.5-1.5h-5.2l-.7-1.1A1.5 1.5 0 0 0 6.5 0z"
            ></path></svg
          >
          <span>Acceso Rápido</span>
        </li>
        <li>
          <a
            href="#"
            class="flex items-center gap-3 p-2 rounded hover:bg-gray-200 dark:hover:bg-white/10 cursor-pointer transition-colors"
          >
            <svg
              class="size-4 text-blue-500"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M4.406 3.342A5.53 5.53 0 0 1 8 2c2.69 0 4.923 2 5.166 4.579C14.758 6.804 16 8.137 16 9.773 16 11.569 14.502 13 12.687 13H3.781C1.708 13 0 11.366 0 9.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383z"
              ></path>
            </svg>
            <span>Deimos - Personal</span>
          </a>
        </li>
        <hr class="border-gray-300 dark:border-white/10 my-2 mx-2" />
        <li>
          <a
            href="#about"
            class="flex items-center gap-3 p-2 rounded hover:bg-gray-200 dark:hover:bg-white/10 cursor-pointer transition-colors"
          >
            <svg
              class="size-4 text-purple-500"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"
              ></path>
            </svg>
            <span>Acerca de mí</span>
          </a>
        </li>
        <li>
          <a
            href="#projects"
            class="flex items-center gap-3 p-2 rounded hover:bg-gray-200 dark:hover:bg-white/10 cursor-pointer transition-colors"
          >
            <svg
              class="size-4 text-emerald-500"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M10.478 1.647a.5.5 0 1 0-.956-.300l-4 13a.5.5 0 0 0 .956.300l4-13zM4.854 4.146a.5.5 0 0 1 0 .708L1.707 8l3.147 3.146a.5.5 0 0 1-.708.708l-3.5-3.5a.5.5 0 0 1 0-.708l3.5-3.5a.5.5 0 0 1 .708 0zm6.292 0a.5.5 0 0 0 0 .708L14.293 8l-3.147 3.146a.5.5 0 0 0 .708.708l3.5-3.5a.5.5 0 0 0 0-.708l-3.5-3.5a.5.5 0 0 0-.708 0z"
              ></path>
            </svg>
            <span>Projectos</span>
          </a>
        </li>
        <li>
          <a
            href="#technologies"
            class="flex items-center gap-3 p-2 rounded hover:bg-gray-200 dark:hover:bg-white/10 cursor-pointer transition-colors"
          >
            <svg
              class="size-4 text-amber-500"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h.5A1.5 1.5 0 0 1 14 3.5V4h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v.5a1.5 1.5 0 0 1-1.5 1.5H12v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-.5A1.5 1.5 0 0 1 2 12.5V12H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2V8H.5a.5.5 0 0 1 0-1H2V6H.5a.5.5 0 0 1 0-1H2v-.5A1.5 1.5 0 0 1 3.5 2H4V.5A.5.5 0 0 1 4.5 0H5zM3.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-9zM5 5h6v6H5V5z"
              ></path>
            </svg>
            <span>Tecnologías</span>
          </a>
        </li>
        <li>
          <a
            href="#contact"
            class="flex items-center gap-3 p-2 rounded hover:bg-gray-200 dark:hover:bg-white/10 cursor-pointer transition-colors"
          >
            <svg
              class="size-4 text-rose-500"
              viewBox="0 0 16 16"
              fill="currentColor"
            >
              <path
                d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"
              ></path>
            </svg>
            <span>Contacto</span>
          </a>
        </li>
      </ul>
    </div>
  </aside>
</div>

<script>
  const wrapper = document.getElementById("sidebar-wrapper");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const openBtn = document.getElementById("open-sidebar-btn");

  if (wrapper && closeBtn && openBtn) {
    closeBtn.addEventListener("click", () => {
      wrapper.classList.remove("sidebar-expanded");
      wrapper.classList.add("sidebar-collapsed");
    });

    openBtn.addEventListener("click", () => {
      wrapper.classList.remove("sidebar-collapsed");
      wrapper.classList.add("sidebar-expanded");
    });
  }
</script>

<style>
  .sidebar-collapsed #windows-sidebar {
    width: 0 !important;
    min-width: 0 !important;
    border-right-width: 0 !important;
    opacity: 0 !important;
  }
  .sidebar-collapsed #open-sidebar-btn {
    opacity: 1 !important;
    pointer-events: auto !important;
    --tw-translate-x: 0px !important;
  }

  .sidebar-expanded #windows-sidebar {
    width: 16rem !important;
    min-width: 16rem !important;
    border-right-width: 1px !important;
    opacity: 1 !important;
  }
  .sidebar-expanded #open-sidebar-btn {
    opacity: 0 !important;
    pointer-events: none !important;
    --tw-translate-x: -100% !important;
  }
</style>
