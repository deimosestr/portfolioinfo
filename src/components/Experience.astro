---
// src/components/Experience.astro
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "2025 - Presente",
    company: "Desarrollador Full-Stack Independiente",
    title: "Software & Soluciones a Medida",
    description:
      "Lideré el diseño y desarrollo integral de aplicaciones web y de escritorio a medida. Construí arquitecturas backend robustas e integraciones de API para impulsar la digitalización y optimizar los flujos operativos de clientes en la región.",
  },
  {
    date: "2025 - 2026",
    company: "Grupo Coda / Hutchison Ports ICAVE",
    title: "Desarrollador Web Jr.",
    description:
      "Lideré la gestión de aplicaciones críticas y el ciclo de vida técnico del software en un entorno portuario de alta exigencia. Diseñé y construí APIs (REST/SOAP) desde cero, administré despliegues en producción mediante Azure, optimicé el rendimiento en bases de datos Oracle y aseguré la continuidad operativa en servidores Apache Tomcat.",
    link: "#",
  },
  {
    date: "2023 - 2024",
    company: "Coordinados de México Oriente, S.A de C.V",
    title: "Residente - Desarrollador de Aplicaciones",
    description:
      "Lideré el desarrollo de un sistema automatizado de gestión de Seguridad e Higiene para Mobility ADO para asegurar el cumplimiento estricto de las normativas internas. Diseñé e implementé la solución como una aplicación de escritorio robusta utilizando Java y JavaFX, respaldada por una base de datos PostgreSQL.",
  },
];
---

<div class="w-full flex flex-col gap-3">
  {EXPERIENCE.map((item) => <ExperienceItem {...item} />)}
</div>
