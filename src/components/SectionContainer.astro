---
// src/components/SectionContainer.astro
const { class: className, id, title } = Astro.props;
---

<section id={id} class={`w-full ${className}`}>
  {
    title && (
      <h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center text-gray-900 dark:text-white transition-colors duration-300">
        <slot name="icon" />
        {title}
      </h2>
    )
  }
  <slot />
</section>
