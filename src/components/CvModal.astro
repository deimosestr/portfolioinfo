---
// src/components/CvModal.astro
const base = import.meta.env.BASE_URL || "/";
const cvPath = `${base}cv.pdf`;
const cvImgPath = `${base}cv_preview.jpg`;
const downloadName = "CV_Jose_Fabian_Salcedo.pdf";
---

<div
  id="cv-modal"
  class="fixed inset-0 z-[99999] flex items-center justify-center p-3 sm:p-4 pt-20 sm:pt-16 bg-black/60 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
>
  <div
    class="relative w-full max-w-4xl h-[85vh] sm:h-[85vh] bg-[#f3f3f3] dark:bg-[#202020] border border-gray-300 dark:border-[#333333] rounded-xl shadow-2xl flex flex-col overflow-hidden transform scale-95 transition-transform duration-300"
    id="cv-modal-window"
  >
    <div
      class="flex items-center justify-between h-10 select-none shrink-0 w-full bg-transparent"
    >
      <div class="flex items-center h-full px-4 gap-2.5">
        <svg
          class="size-4 text-purple-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        <span class="text-xs font-normal text-gray-800 dark:text-gray-200">
          CV_JOSE_FABIAN.pdf
        </span>
      </div>

      <div class="flex h-full">
        <button
          class="w-11 h-full flex items-center justify-center text-gray-600 dark:text-gray-400 hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-default"
        >
          <svg
            class="size-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 12h16"></path></svg
          >
        </button>
        <button
          class="w-11 h-full flex items-center justify-center text-gray-600 dark:text-gray-400 hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-default"
        >
          <svg
            class="size-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><rect x="4" y="4" width="16" height="16" rx="2" stroke-width="1.5"
            ></rect></svg
          >
        </button>
        <button
          id="close-cv-modal"
          class="w-11 h-full flex items-center justify-center text-gray-600 dark:text-gray-400 hover:bg-[#c42b1c] hover:text-white transition-colors"
          aria-label="Cerrar modal"
        >
          <svg
            class="size-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>
    </div>

    <div
      class="flex items-center px-2 py-1.5 border-b border-gray-300 dark:border-[#333333] bg-[#f9f9f9] dark:bg-[#191919] shrink-0"
    >
      <a
        href={cvPath}
        download={downloadName}
        class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-gray-800 dark:text-gray-200 hover:bg-black/5 dark:hover:bg-white/10 rounded transition-colors"
      >
        <svg
          class="size-4 text-gray-600 dark:text-gray-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path></svg
        >
        Descargar PDF
      </a>
    </div>

    <div
      class="flex-1 w-full bg-[#525659] dark:bg-[#1c1c1c] relative overflow-auto flex flex-col items-center p-4 sm:p-8"
    >
      <img
        src={cvImgPath}
        alt="Vista previa del CV"
        class="shadow-2xl max-w-full h-auto rounded bg-white"
        loading="eager"
      />
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("cv-modal");
  const modalWindow = document.getElementById("cv-modal-window");
  const closeBtn = document.getElementById("close-cv-modal");
  const openTriggers = document.querySelectorAll(".open-cv-modal");

  if (modal) {
    document.body.appendChild(modal);
  }

  function openModal(e: Event) {
    e.preventDefault();
    if (modal && modalWindow) {
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add("opacity-100");
      modalWindow.classList.remove("scale-95");
      modalWindow.classList.add("scale-100");
      document.body.style.overflow = "hidden";
    }
  }

  function closeModal() {
    if (modal && modalWindow) {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0", "pointer-events-none");
      modalWindow.classList.remove("scale-100");
      modalWindow.classList.add("scale-95");
      document.body.style.overflow = "auto";
    }
  }

  openTriggers.forEach((trigger) => {
    trigger.addEventListener("click", openModal);
  });

  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeModal();
    }
  });
</script>
