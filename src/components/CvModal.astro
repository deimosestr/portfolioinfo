---
// src/components/CvModal.astro
const base = import.meta.env.BASE_URL || "/";
const cvPath = `${base}cv.pdf`; 
const downloadName = "CV_Jose_Fabian_Salcedo.pdf";
---

<div
  id="cv-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 pt-20 sm:pt-16 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
>
  <div
    class="relative w-full max-w-4xl h-[85vh] sm:h-[80vh] bg-white dark:bg-[#1e1e1e] border border-gray-300 dark:border-white/10 rounded-xl shadow-2xl flex flex-col overflow-hidden transform scale-95 transition-transform duration-300"
    id="cv-modal-window"
  >
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-0 px-3 sm:px-4 py-3 bg-gray-100 dark:bg-[#252525] border-b border-gray-200 dark:border-white/10 select-none shrink-0"
    >
      <div class="flex items-center gap-2 overflow-hidden w-full sm:w-auto">
        <svg
          class="size-4 text-purple-500 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        <span
          class="text-xs font-semibold text-gray-700 dark:text-gray-200 truncate"
          >CV_JOSE_FABIAN.pdf</span
        >
      </div>

      <div
        class="flex items-center justify-between sm:justify-end gap-2 w-full sm:w-auto"
      >
        <a
          href={cvPath}
          download={downloadName}
          class="px-3 py-1.5 text-xs font-medium text-white bg-purple-600 hover:bg-purple-700 rounded transition-colors flex items-center justify-center gap-1.5 shadow-sm flex-1 sm:flex-initial"
        >
          <svg
            class="size-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            ></path>
          </svg>
          Descargar
        </a>

        <button
          id="close-cv-modal"
          class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-gray-200 dark:hover:bg-white/10 rounded transition-colors shrink-0"
          aria-label="Cerrar modal"
        >
          <svg
            class="size-5 sm:size-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      class="flex-1 w-full bg-gray-100 dark:bg-[#141414] relative overflow-hidden flex flex-col"
    >
      <iframe
        src={`${cvPath}#toolbar=0&view=FitH`}
        class="w-full h-full border-none"
        title="Vista previa del CV"></iframe>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("cv-modal");
  const modalWindow = document.getElementById("cv-modal-window");
  const closeBtn = document.getElementById("close-cv-modal");
  const openTriggers = document.querySelectorAll(".open-cv-modal");

  function openModal(e: Event) {
    e.preventDefault();
    if (modal && modalWindow) {
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.classList.add("opacity-100");
      modalWindow.classList.remove("scale-95");
      modalWindow.classList.add("scale-100");
      document.body.style.overflow = "hidden";
    }
  }

  function closeModal() {
    if (modal && modalWindow) {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0", "pointer-events-none");
      modalWindow.classList.remove("scale-100");
      modalWindow.classList.add("scale-95");
      document.body.style.overflow = "auto";
    }
  }

  openTriggers.forEach((trigger) => {
    trigger.addEventListener("click", openModal);
  });

  closeBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeModal();
    }
  });
</script>
