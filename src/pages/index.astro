---
// src/pages/index.astro
import Badge from "../components/Badge.astro";
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import MailIcon from "../components/icons/Mail.astro";
import Experience from "../components/Experience.astro";
import ExperienceIcon from "../components/icons/BriefcaseIcon.astro";
import CodeIcon from "../components/icons/Code.astro";
import Projects from "../components/Projects.astro";
import WindowsSidebar from "../components/WSidebar.astro";
import Technologies from "../components/Technologies.astro";
import ContactMe from "../components/ContactMe.astro";
import About from "../components/About.astro";
import CvModal from "../components/CvModal.astro";
---

<Layout
  title="Portfolio Jose Fabian - Desarrollador y programador web."
  description="Informacion personal a cerca de mí."
>
  <div class="flex flex-row flex-1 min-h-0 w-full overflow-hidden bg-[#141414]">
    <WindowsSidebar />

    <main
      class="flex-1 flex flex-col gap-y-20 pb-24 min-h-0 overflow-y-auto custom-scrollbar bg-white dark:bg-[#1c1c1c] transition-colors duration-300 px-0 scroll-smooth relative"
    >
      <SectionContainer
        id="perfil"
        class="relative overflow-hidden border-b border-gray-300 dark:border-white/10 min-h-[90vh] flex flex-col justify-center shrink-0"
      >
        <div
          class="absolute inset-0 w-full h-full bg-cover bg-center transition-transform duration-700 hover:scale-105"
          style="background-image: url('/src/components/photos/background_photo.png');"
        >
        </div>

        <div class="absolute inset-0 bg-black/60 dark:bg-black/70"></div>

        <div
          class="relative z-10 px-6 md:px-12 py-16 md:py-24 flex flex-col items-start"
        >
          <img
            class="rounded-full size-24 md:size-28 mb-6 border-2 border-white/20 shadow-lg object-cover"
            src="/src/components/photos/1595.jpg"
            alt="Foto de Fabián"
          />

          <h1
            class="text-white text-3xl md:text-5xl font-bold flex flex-row flex-wrap items-center gap-x-4 pb-4"
          >
            Hola, soy José Fabián
            <a
              href="https://www.linkedin.com/in/josé-fabián-salcedo-estrada-ba3a81241"
              target="_blank"
              rel="noopener"
            >
              <div
                class="flex justify-center items-center hover:scale-105 transition mt-2 md:mt-0"
              >
                <Badge>Disponible para trabajar</Badge>
              </div>
            </a>
          </h1>

          <h2
            class="text-xl md:text-2xl text-wrap max-w-[700px] text-gray-200 mt-4 leading-relaxed"
          >
            <span
              class="text-sky-400 dark:text-sky-300 font-semibold drop-shadow-md"
            >
              Desarrollador Backend & Full Stack.
            </span>
            <span class="text-gray-300">
              Especializado en arquitecturas escalables, automatización de
              procesos y despliegue de soluciones robustas en la nube.
            </span>
          </h2>

          <div
            class="flex items-center gap-4 text-sm text-gray-300 mt-6 flex-wrap"
          >
            <span class="flex items-center gap-1.5">
              <svg
                class="size-4 text-sky-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
              >
              Backend & Cloud Architecture
            </span>
            <span>•</span>
            <span class="flex items-center gap-1.5">
              <svg
                class="size-4 text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
              >
              México
            </span>
            <span>•</span>
            <a
              href="#"
              class="open-cv-modal inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-full transition-all shadow-sm backdrop-blur-md cursor-pointer"
            >
              <svg
                class="size-3.5 text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Ver CV
            </a>
          </div>
        </div>
      </SectionContainer>

      <SectionContainer id="about" class="px-6 md:px-12" title="Acerca de mí">
        <CodeIcon
          slot="icon"
          class="size-7 text-green-600 dark:text-green-400"
        />
        <About />
      </SectionContainer>

      <SectionContainer id="projects" class="px-6 md:px-12" title="Proyectos">
        <CodeIcon
          slot="icon"
          class="size-7 text-green-600 dark:text-green-400"
        />
        <Projects />
      </SectionContainer>

      <SectionContainer
        id="technologies"
        class="px-6 md:px-12"
        title="Tecnologías"
      >
        <svg
          slot="icon"
          class="size-7 text-amber-500"
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            d="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h.5A1.5 1.5 0 0 1 14 3.5V4h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v.5a1.5 1.5 0 0 1-1.5 1.5H12v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-.5A1.5 1.5 0 0 1 2 12.5V12H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2V8H.5a.5.5 0 0 1 0-1H2V6H.5a.5.5 0 0 1 0-1H2v-.5A1.5 1.5 0 0 1 3.5 2H4V.5A.5.5 0 0 1 4.5 0H5zM3.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-9zM5 5h6v6H5V5z"
          ></path>
        </svg>
        <Technologies />
      </SectionContainer>

      <SectionContainer
        id="experience"
        class="px-6 md:px-12"
        title="Experiencia laboral"
      >
        <ExperienceIcon
          slot="icon"
          class="size-7 text-purple-600 dark:text-purple-400"
        />
        <Experience />
      </SectionContainer>

      <SectionContainer id="contact" class="px-6 md:px-12" title="Contacto">
        <MailIcon
          slot="icon"
          class="size-7 text-green-600 dark:text-green-400"
        />
        <ContactMe />
      </SectionContainer>
    </main>
  </div>
  <CvModal />
</Layout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    border: 2px solid transparent;
    background-clip: content-box;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.4);
  }
  html {
    scroll-behavior: smooth;
  }
</style>
